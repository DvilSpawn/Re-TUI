<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <provider android:name="ohi.andre.consolelauncher.managers.settings.PaletteFixtureProvider"
            android:authorities="${applicationId}.palette-fixtures"
            android:exported="true" android:grantUriPermissions="true" />
        <provider android:name="ohi.andre.consolelauncher.managers.PresetFixtureProvider"
            android:authorities="${applicationId}.portable-fixtures"
            android:process=":preset_recipient"
            android:exported="true" android:grantUriPermissions="true" />
        <receiver android:name="ohi.andre.consolelauncher.managers.widgets.WidgetPaneFixtureProvider"
            android:label="ReTUI Widget Fixture" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_pane_fixture" />
        </receiver>
    </application>
</manifest>
