<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/termux_workspace_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:paddingStart="8dp"
    android:paddingTop="0dp"
    android:paddingEnd="8dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/termux_workspace_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="2dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingTop="28dp"
        android:paddingEnd="6dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/termux_workspace_pages"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:visibility="gone">
            <TextView android:id="@+id/termux_workspace_page_previous"
                android:layout_width="48dp" android:layout_height="match_parent"
                android:gravity="center" android:text="‹"
                android:contentDescription="@string/workspace_page_previous" />
            <TextView android:id="@+id/termux_workspace_page_position"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                android:gravity="center" />
            <TextView android:id="@+id/termux_workspace_page_next"
                android:layout_width="48dp" android:layout_height="match_parent"
                android:gravity="center" android:text="›"
                android:contentDescription="@string/workspace_page_next" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/termux_workspace_output_panel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false" />

        <include layout="@layout/termux_special_keys" />

        <LinearLayout
            android:id="@+id/termux_workspace_input_group"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="0dp"
            android:alpha="0"
            android:gravity="center_vertical"
            android:minHeight="1dp"
            android:orientation="horizontal"
            android:paddingStart="0dp"
            android:paddingTop="0dp"
            android:paddingEnd="0dp"
            android:paddingBottom="0dp">

                <ohi.andre.consolelauncher.managers.termux.TermuxWorkspaceInputEditText
                    android:id="@+id/termux_workspace_input"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:background="@null"
                    android:hint=""
                    android:imeOptions="actionGo|flagNoFullscreen"
                    android:importantForAutofill="no"
                    android:inputType="text|textNoSuggestions"
                    android:minHeight="1dp"
                    android:padding="0dp"
                    android:singleLine="true"
                    style="@style/Retui.Text.Body" />

        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/termux_workspace_chrome"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/termux_workspace_label"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="20dp"
            android:layout_gravity="top"
            android:layout_marginEnd="4dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxWidth="128dp"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingTop="0dp"
            android:paddingEnd="10dp"
            android:paddingBottom="0dp"
            android:singleLine="true"
            android:text="@string/ui_termux_workspace_page_termux_workspace"
            style="@style/Retui.Text.Body" />

        <TextView
            android:id="@+id/termux_workspace_home"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text=""
            style="@style/Retui.Text.Control" />

        <TextView
            android:id="@+id/termux_workspace_new"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:layout_marginStart="0dp"
            android:gravity="center"
            android:text=""
            style="@style/Retui.Text.Body" />

        <TextView
            android:id="@+id/termux_workspace_ime"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:layout_marginStart="0dp"
            android:gravity="center"
            android:text=""
            style="@style/Retui.Text.Caption" />
        <TextView
            android:id="@+id/termux_workspace_layout"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:contentDescription="@string/workspace_layout"
            style="@style/Retui.Text.Control" />
    </LinearLayout>

</FrameLayout>
