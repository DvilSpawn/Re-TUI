<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/apps_drawer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:visibility="gone"
    android:clickable="true"
    android:focusable="true">

    <View
        android:id="@+id/apps_drawer_dummy_input_anchor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_alignParentBottom="true"
        android:visibility="invisible" />

    <LinearLayout
        android:id="@+id/apps_drawer_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/apps_drawer_dummy_input_anchor"
        android:orientation="vertical"
        android:layout_marginStart="8dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/apps_drawer_border"
        android:padding="2dp">

        <LinearLayout
            android:id="@+id/apps_drawer_filter_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="58dp"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="42dp"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="4dp">

            <ImageView
                android:id="@+id/apps_drawer_filter_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_toolbar_search_24" />

            <EditText
                android:id="@+id/apps_drawer_filter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:ellipsize="end"
                android:hint="@string/ui_apps_drawer_filter_hint"
                android:imeOptions="actionGo|flagNoFullscreen"
                android:importantForAutofill="no"
                android:inputType="text|textNoSuggestions"
                android:maxLines="1"
                android:minHeight="40dp"
                android:paddingStart="8dp"
                android:paddingEnd="4dp"
                style="@style/Retui.Text.Body"
                android:fontFamily="monospace" />

            <ImageView
                android:id="@+id/apps_drawer_filter_clear"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/ui_apps_drawer_filter_clear"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_clear"
                android:visibility="gone" />
        </LinearLayout>

        <ListView
            android:id="@+id/apps_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp"
            android:fastScrollEnabled="false"
            android:listSelector="@android:color/transparent"
            android:paddingStart="58dp"
            android:paddingTop="4dp"
            android:paddingEnd="42dp"
            android:paddingBottom="44dp"
            android:scrollbars="none" />

    </LinearLayout>

    <TextView
        android:id="@+id/apps_drawer_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/apps_drawer_container"
        android:layout_alignStart="@id/apps_drawer_container"
        android:layout_marginTop="-10dp"
        android:layout_marginStart="24dp"
        android:background="@drawable/apps_drawer_header_border"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:text="@string/ui_apps_drawer_applications_s"
        style="@style/Retui.Text.Body"
        android:fontFamily="monospace" />

    <ScrollView
        android:id="@+id/apps_group_tabs_scroll"
        android:layout_width="42dp"
        android:layout_height="match_parent"
        android:layout_alignTop="@id/apps_drawer_container"
        android:layout_alignBottom="@id/apps_drawer_container"
        android:layout_alignStart="@id/apps_drawer_container"
        android:layout_marginStart="-10dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/apps_group_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/apps_alpha_tabs_scroll"
        android:layout_width="34dp"
        android:layout_height="match_parent"
        android:layout_alignTop="@id/apps_drawer_container"
        android:layout_alignBottom="@id/apps_drawer_container"
        android:layout_alignEnd="@id/apps_drawer_container"
        android:layout_marginEnd="-10dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/apps_alpha_tabs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical" />
    </LinearLayout>

    <TextView
        android:id="@+id/apps_drawer_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@id/apps_drawer_container"
        android:layout_alignEnd="@id/apps_drawer_container"
        android:layout_marginBottom="-10dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/apps_drawer_header_border"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:text="@string/ui_apps_drawer_total_0"
        style="@style/Retui.Text.Control"
        android:fontFamily="monospace" />

</RelativeLayout>
