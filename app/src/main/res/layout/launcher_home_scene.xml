<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/main_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/header_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                layout="@layout/about_device_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/view_pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/terminal_tray_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <include
            layout="@layout/terminal_page"
            android:layout_width="match_parent"
            android:layout_height="112dp" />

        <ScrollView
            android:id="@+id/search_mode_results_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/search_mode_results_group"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="bottom"
                android:orientation="vertical" />

        </ScrollView>

        <LinearLayout
            android:id="@+id/unified_bottom_console"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/unified_status_host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false" />

            <FrameLayout
                android:id="@+id/unified_dock_host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <ScrollView
                android:id="@+id/unified_module_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="false"
                android:overScrollMode="ifContentScrolls"
                android:scrollbars="vertical"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/unified_module_host"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </ScrollView>

        </LinearLayout>

        <!-- Persistent Input Area -->
        <LinearLayout
            android:id="@+id/persistent_input_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/search_mode_tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:visibility="gone">
            <TextClock
                android:id="@+id/search_mode_clock_tab"
                style="@style/Retui.Text.Control"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:format12Hour="EEE, MMM d  •  h:mm a"
                android:format24Hour="EEE, MMM d  •  HH:mm"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:visibility="gone" />

                <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <ImageButton
                    android:id="@+id/terminal_home_add_tab"
                    android:layout_width="36dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="4dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_workspace_add_24"
                    android:contentDescription="@string/terminal_home_add"
                    android:visibility="gone" />
                <ImageButton
                    android:id="@+id/terminal_home_settings_tab"
                    android:layout_width="36dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="18dp"
                    android:padding="6dp"
                    android:src="@drawable/remember_ic_settings"
                    android:contentDescription="@string/terminal_home_settings"
                    android:visibility="gone" />
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/module_suggestions_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/module_suggestions_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="start|center_vertical"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

            <LinearLayout android:id="@+id/input_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:weightSum="@integer/input_group_weightsum">

                <ohi.andre.consolelauncher.tuils.OutlineTextView
                    android:id="@+id/prefix_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <ohi.andre.consolelauncher.tuils.OutlineEditText
                    android:id="@+id/input_view"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="@integer/input_view_weight"

                    android:background="@null"
                    android:imeOptions="actionGo|flagNoFullscreen"
                    android:textCursorDrawable="@drawable/cursor"

                    android:importantForAutofill="no"

                    android:lines="1"
                    android:singleLine="true"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="@integer/enter_view_weight"

                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:id="@+id/submit_tv"

                        android:background="@null"
                        android:contentDescription="@string/cd_submit_command"
                        android:src="@drawable/ic_enter"/>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout android:id="@+id/tools_view"
                android:layout_width="match_parent"
                android:layout_height="@dimen/tools_height"
                android:orientation="horizontal"
                android:weightSum="7">

                <ImageButton android:id="@+id/delete_view"
                    style="@style/ToolsBar"
                    android:contentDescription="@string/cd_clear_input"
                    android:src="@drawable/ic_clear"/>

                <ImageButton android:id="@+id/back_view"
                    style="@style/ToolsBar"
                    android:contentDescription="@string/cd_history_back"
                    android:src="@drawable/ic_back"/>

                <ImageButton android:id="@+id/next_view"
                    style="@style/ToolsBar"
                    android:contentDescription="@string/cd_history_forward"
                    android:src="@drawable/ic_next"/>

                <ImageButton android:id="@+id/paste_view"
                    style="@style/ToolsBar"
                    android:contentDescription="@string/cd_paste_clipboard"
                    android:src="@drawable/ic_paste"/>

                <ImageButton android:id="@+id/app_drawer_view"
                    style="@style/ToolsBar"
                    android:background="@null"
                    android:contentDescription="@string/cd_open_app_drawer"
                    android:src="@drawable/ic_menu"/>

                <ImageButton android:id="@+id/android_widget_drawer_view"
                    style="@style/ToolsBar"
                    android:background="@null"
                    android:contentDescription="@string/ui_base_view_android_widgets"
                    android:src="@drawable/ic_toolbar_widgets_24"/>

                <ImageButton android:id="@+id/termux_workspace_view"
                    style="@style/ToolsBar"
                    android:background="@null"
                    android:contentDescription="@string/ui_base_view_termux_workspace"
                    android:src="@drawable/ic_toolbar_terminal_24"/>

            </LinearLayout>

            <HorizontalScrollView android:id="@+id/suggestions_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/suggestions_group"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="start|center_vertical"
                        android:orientation="horizontal">

                    </LinearLayout>

                </LinearLayout>

            </HorizontalScrollView>
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/landscape_split_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:weightSum="2"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/landscape_left_pane"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false" />

        <View
            android:id="@+id/landscape_fold_gutter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/landscape_right_pane"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false" />

    </LinearLayout>

</merge>
