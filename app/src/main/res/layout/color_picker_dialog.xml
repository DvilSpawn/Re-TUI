<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/picker_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ui_color_picker_dialog_color_picker"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:textSize="18sp"
        android:layout_marginBottom="10dp"/>

    <View
        android:id="@+id/color_preview"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="20dp" />

    <!-- Alpha -->
    <TextView
        android:id="@+id/alpha_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ui_color_picker_dialog_opacity_alpha"
        android:textSize="12sp"
        android:fontFamily="monospace" />
    <SeekBar
        android:id="@+id/seek_alpha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="255"
        android:progress="255" />

    <!-- Hue -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ui_color_picker_dialog_hue"
        android:textSize="12sp"
        android:fontFamily="monospace" />
    <SeekBar
        android:id="@+id/seek_hue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="360" />

    <!-- Saturation -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ui_color_picker_dialog_saturation"
        android:textSize="12sp"
        android:fontFamily="monospace" />
    <SeekBar
        android:id="@+id/seek_sat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100" />

    <!-- Brightness -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ui_color_picker_dialog_brightness_value"
        android:textSize="12sp"
        android:fontFamily="monospace" />
    <SeekBar
        android:id="@+id/seek_val"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100" />

    <TextView
        android:id="@+id/hex_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="10dp"
        android:fontFamily="monospace"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/hex_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/wallpaper_hex_hint"
        android:inputType="textVisiblePassword"
        android:singleLine="true"
        android:fontFamily="monospace"
        android:textSize="16sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/auto_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:padding="10dp"
        android:text="@string/ui_color_picker_dialog_auto"
        android:visibility="gone" />

</LinearLayout>
