<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/profile_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="32dp"
    android:paddingEnd="32dp"
    android:paddingBottom="4dp"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/profile_window_border"
        android:layout_width="match_parent"
        android:layout_height="620dp"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="34dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="128dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/profile_photo"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:contentDescription="@string/ui_profile_surface_temporary_profile_portrait"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_profile_surface_identity"
                    style="@style/Retui.Text.Micro" />

                <TextView
                    android:id="@+id/profile_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_profile_surface_operator"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/ui_profile_surface_phone_tap_to_reveal_30s"
                    style="@style/Retui.Text.Micro" />

                <TextView
                    android:id="@+id/profile_phone"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:contentDescription="@string/ui_profile_surface_masked_phone_number_tap_to_reveal_for_30_seconds"
                    android:gravity="center_vertical"
                    android:text="@string/ui_profile_surface_not_set"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/profile_edit"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/ui_profile_surface_edit_profile" />

            <TextView
                android:id="@+id/profile_add_qr"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/ui_profile_surface_add_qr" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ui_profile_surface_connection_codes"
                style="@style/Retui.Text.Caption" />

            <TextView
                android:id="@+id/profile_qr_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_token_d9fa58d9ac"
                style="@style/Retui.Text.Caption" />
        </LinearLayout>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/profile_qr_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/profile_remove_qr"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/ui_profile_surface_remove_current_qr" />
    </LinearLayout>

    <TextView
        android:id="@+id/profile_window_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="38dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:minWidth="160dp"
        android:paddingStart="12dp"
        android:paddingTop="2dp"
        android:paddingEnd="12dp"
        android:paddingBottom="2dp"
        android:text="@string/ui_profile_surface_profile_local_id"
        style="@style/Retui.Text.Body" />

    <TextView
        android:id="@+id/profile_close"
        android:layout_width="48dp"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/ui_profile_surface_x"
        style="@style/Retui.Text.Header" />
</FrameLayout>
