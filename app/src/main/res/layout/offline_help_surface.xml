<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/offline_help_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="8dp">
    <TextView android:id="@+id/offline_help_header" android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical" android:text="@string/offline_help_title" />
    <LinearLayout android:id="@+id/offline_help_panel" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:padding="8dp">
        <ScrollView android:id="@+id/offline_help_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <TextView android:id="@+id/offline_help_output" android:layout_width="match_parent" android:layout_height="wrap_content" />
        </ScrollView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
            <TextView android:id="@+id/offline_help_prompt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="help&gt; " />
            <EditText android:id="@+id/offline_help_input" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@null" android:padding="0dp" android:singleLine="true" android:contentDescription="@string/offline_help_choice" />
        </LinearLayout>
    </LinearLayout>
    <GridLayout android:id="@+id/offline_help_keys" android:layout_width="match_parent" android:layout_height="96dp" android:columnCount="6" android:rowCount="2" />
</LinearLayout>
