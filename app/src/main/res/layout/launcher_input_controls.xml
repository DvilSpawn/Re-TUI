<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
            <LinearLayout android:id="@+id/input_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:weightSum="@integer/input_group_weightsum">

                <ohi.andre.consolelauncher.tuils.OutlineTextView
                    android:id="@+id/prefix_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <ohi.andre.consolelauncher.tuils.OutlineEditText
                    android:id="@+id/input_view"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="@integer/input_view_weight"

                    android:background="@null"
                    android:imeOptions="actionGo|flagNoFullscreen"
                    android:textCursorDrawable="@drawable/cursor"

                    android:importantForAutofill="no"

                    android:lines="1"
                    android:singleLine="true"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="@integer/enter_view_weight"

                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:id="@+id/submit_tv"

                        android:background="@null"
                        android:contentDescription="@string/cd_submit_command"
                        android:src="@drawable/ic_enter"/>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout android:id="@+id/tools_view"
                android:layout_width="match_parent"
                android:layout_height="@dimen/tools_height"
                android:orientation="horizontal"
                android:weightSum="7">

                <ImageButton android:id="@+id/delete_view"
                    style="@style/ToolsBar"
                    android:contentDescription="@string/cd_clear_input"
                    android:src="@drawable/ic_clear"/>

                <ImageButton android:id="@+id/back_view"
                    style="@style/ToolsBar"
                    android:contentDescription="@string/cd_history_back"
                    android:src="@drawable/ic_back"/>

                <ImageButton android:id="@+id/next_view"
                    style="@style/ToolsBar"
                    android:contentDescription="@string/cd_history_forward"
                    android:src="@drawable/ic_next"/>

                <ImageButton android:id="@+id/paste_view"
                    style="@style/ToolsBar"
                    android:contentDescription="@string/cd_paste_clipboard"
                    android:src="@drawable/ic_paste"/>

                <ImageButton android:id="@+id/app_drawer_view"
                    style="@style/ToolsBar"
                    android:background="@null"
                    android:contentDescription="@string/cd_open_app_drawer"
                    android:src="@drawable/ic_menu"/>

                <ImageButton android:id="@+id/android_widget_drawer_view"
                    style="@style/ToolsBar"
                    android:background="@null"
                    android:contentDescription="@string/ui_base_view_android_widgets"
                    android:src="@drawable/ic_toolbar_widgets_24"/>

                <ImageButton android:id="@+id/termux_workspace_view"
                    style="@style/ToolsBar"
                    android:background="@null"
                    android:contentDescription="@string/ui_base_view_termux_workspace"
                    android:src="@drawable/ic_toolbar_terminal_24"/>

            </LinearLayout>

            <HorizontalScrollView android:id="@+id/suggestions_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/suggestions_group"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="start|center_vertical"
                        android:orientation="horizontal">

                    </LinearLayout>

                </LinearLayout>

            </HorizontalScrollView>
</merge>
