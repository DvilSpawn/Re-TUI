<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lockdown_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="20dp">

    <ImageView
        android:id="@+id/lockdown_title"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/ui_lockdown_overlay_lockdown"
        android:scaleType="fitCenter"
        android:src="@drawable/lockdown_wordmark" />

    <TextView
        android:id="@+id/lockdown_reason"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/ui_lockdown_overlay_focus_mode"
        style="@style/Retui.Text.Body" />

    <TextView
        android:id="@+id/lockdown_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/ui_token_155130c69f"
        style="@style/Retui.Text.Display"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lockdown_wallet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="@string/ui_lockdown_overlay_credits_1000_keys_0"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/lockdown_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/lockdown_skip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/ui_lockdown_overlay_skip_lockdown_500_credits"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lockdown_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/ui_lockdown_overlay_use_breach_key"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lockdown_breach"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/ui_lockdown_overlay_emergency_breach"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
