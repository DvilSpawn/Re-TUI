<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/podcast_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="8dp"
    android:paddingTop="0dp"
    android:paddingEnd="8dp"
    android:paddingBottom="4dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:visibility="gone">

    <FrameLayout
        android:id="@+id/podcast_window_border"
        android:layout_width="match_parent"
        android:layout_height="620dp"
        android:layout_gravity="center_vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="28dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/podcast_tabs"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/podcast_tab_shows"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/ui_podcast_surface_shows"
                style="@style/Retui.Text.Caption" />

            <TextView
                android:id="@+id/podcast_play_show"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/ui_podcast_surface_recents"
                style="@style/Retui.Text.Caption" />

            <TextView
                android:id="@+id/podcast_add"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/ui_podcast_surface_add"
                style="@style/Retui.Text.Caption" />

            <TextView
                android:id="@+id/podcast_refresh"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/ui_podcast_surface_refresh"
                style="@style/Retui.Text.Caption" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/podcast_content_panel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="8dp"
            android:paddingTop="12dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <ScrollView
                android:id="@+id/podcast_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:paddingBottom="52dp">

                <LinearLayout
                    android:id="@+id/podcast_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <TextView
                android:id="@+id/podcast_content_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="12dp"
                android:layout_marginTop="-12dp"
                android:contentDescription="@string/ui_podcast_surface_back_to_shows"
                android:gravity="center"
                android:minWidth="44dp"
                android:paddingStart="8dp"
                android:paddingTop="1dp"
                android:paddingEnd="8dp"
                android:paddingBottom="1dp"
                android:text="@string/ui_token_3ef9bbcc6e"
                style="@style/Retui.Text.Control"
                android:visibility="gone" />

            <TextView
                android:id="@+id/podcast_content_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="12dp"
                android:layout_marginTop="-12dp"
                android:gravity="center"
                android:minWidth="104dp"
                android:paddingStart="10dp"
                android:paddingTop="1dp"
                android:paddingEnd="10dp"
                android:paddingBottom="1dp"
                android:text="@string/ui_podcast_surface_shows"
                android:textAllCaps="true"
                style="@style/Retui.Text.Control"
                android:visibility="visible" />

            <LinearLayout
                android:id="@+id/podcast_pane_actions"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                android:gravity="center"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/podcast_player_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="10dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/podcast_player_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/ui_token_1ee7d42bf0"
                    style="@style/Retui.Text.Control" />

                <SeekBar
                    android:id="@+id/podcast_player_seek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:max="100"
                    android:progress="0" />

                <LinearLayout
                    android:id="@+id/podcast_player_transport"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/podcast_player_prev"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/ui_podcast_surface_prev"
                        style="@style/Retui.Text.Caption" />

                    <TextView
                        android:id="@+id/podcast_player_rewind"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/ui_token_4dbd0be334"
                        style="@style/Retui.Text.Caption" />

                    <TextView
                        android:id="@+id/podcast_player_play"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/ui_podcast_surface_play"
                        style="@style/Retui.Text.Caption" />

                    <TextView
                        android:id="@+id/podcast_player_forward"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/ui_token_572cc15594"
                        style="@style/Retui.Text.Caption" />

                    <TextView
                        android:id="@+id/podcast_player_next"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/ui_podcast_surface_next"
                        style="@style/Retui.Text.Caption" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/podcast_now_playing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/podcast_artwork"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:contentDescription="@string/ui_podcast_surface_podcast_artwork"
                    android:scaleType="centerCrop"
                    android:src="@mipmap/ic_launcher" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/podcast_now_meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/ui_podcast_surface_add_a_feed_then_play_a_show"
                        style="@style/Retui.Text.Caption" />

                    <TextView
                        android:id="@+id/podcast_now_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/ui_podcast_surface_no_podcast_playing"
                        style="@style/Retui.Text.Control" />

                    <TextView
                        android:id="@+id/podcast_now_progress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/ui_token_1ee7d42bf0"
                        style="@style/Retui.Text.Caption" />
                </LinearLayout>
            </LinearLayout>

            <SeekBar
                android:id="@+id/podcast_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:enabled="false"
                android:max="100"
                android:progress="0" />

            <LinearLayout
                android:id="@+id/podcast_transport"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/podcast_prev"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/ui_podcast_surface_prev"
                    style="@style/Retui.Text.Caption" />

                <TextView
                    android:id="@+id/podcast_rewind"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/ui_token_4dbd0be334"
                    style="@style/Retui.Text.Caption" />

                <TextView
                    android:id="@+id/podcast_play"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/ui_podcast_surface_play"
                    style="@style/Retui.Text.Caption" />

                <TextView
                    android:id="@+id/podcast_forward"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/ui_token_572cc15594"
                    style="@style/Retui.Text.Caption" />

                <TextView
                    android:id="@+id/podcast_next"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/ui_podcast_surface_next"
                    style="@style/Retui.Text.Caption" />
            </LinearLayout>
        </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/podcast_window_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="38dp"
            android:layout_marginTop="-10dp"
            android:gravity="center"
            android:minWidth="160dp"
            android:paddingStart="12dp"
            android:paddingTop="2dp"
            android:paddingEnd="12dp"
            android:paddingBottom="2dp"
            android:text="@string/ui_podcast_surface_podcasts"
            style="@style/Retui.Text.Body" />

        <TextView
            android:id="@+id/podcast_close"
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-10dp"
            android:gravity="center"
            android:text="@string/ui_token_6a4e6e729f"
            style="@style/Retui.Text.Title" />
    </FrameLayout>

</FrameLayout>
