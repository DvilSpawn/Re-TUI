    <!-- tbridge.kt: retiredFileListingMessage -->
    <string name="command_detail_tbridge_tbridge_file_listing_is_retired_from_the_p_d319c" formatted="false">"TBridge file listing is retired from the public command surface.\nUse files, ls, open, or share through Re:T-UI Files.\nTBridge now focuses on Termux runtime checks, scripts, modules, callbacks, and automation."</string>
    <!-- tbridge.kt: setupText -->
    <string name="command_detail_tbridge_termux_bridge_setup_for_scripts_modules_an_de1dc" formatted="false">"Termux bridge setup for scripts, modules, and automation:\n1. Install Termux.\n2. In Termux run: termux-setup-storage\n3. In Termux run: mkdir -p ~/.termux &amp;&amp; echo allow-external-apps=true &gt;&gt; ~/.termux/termux.properties\n4. Restart Termux.\n5. Grant Re:T-UI the RUN_COMMAND permission from Android app settings.\n6. Run: tbridge -doctor\n\nUse files for file navigation. TBridge is now the Termux runtime for scripts and modules."</string>
